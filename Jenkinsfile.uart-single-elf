pipeline {
    agent {
        node {
            label 'riscv-hw-agent'
            customWorkspace '/data/ci/agent/workspace/riscv-uart-single-elf'
        }
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '50', artifactNumToKeepStr: '30'))
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        skipDefaultCheckout(true)
    }

    parameters {
        string(name: 'SUBMISSION_ID', defaultValue: '', description: 'Portal submission UUID.')
        choice(name: 'TARGET_BOARD', choices: ['visionfive2', 'bananapi-f3', 'milkv-megrez'],
               description: 'Physical board selected on the portal.')
        string(name: 'ELF_DOWNLOAD_URL', defaultValue: '', description: 'Token-protected portal ELF URL.')
        password(name: 'ELF_DOWNLOAD_TOKEN', defaultValue: '', description: 'Per-submission ELF token.')
        string(name: 'ELF_SHA256', defaultValue: '', description: 'Expected uploaded ELF SHA-256.')
        string(name: 'ELF_NAME', defaultValue: 'uploaded.elf', description: 'Original ELF display name.')
        string(name: 'RUNNER_BRANCH', defaultValue: 'vf2-uart-stream-jenkins',
               description: 'Runner repository branch.')
        string(name: 'RUNNER_REVISION_OVERRIDE', defaultValue: '',
               description: 'Optional exact runner commit for reproducible reruns.')
        string(name: 'SERIAL_DEV', defaultValue: '',
               description: 'USB-UART device; blank uses the board\'s /dev/ttyCI-<board> name.')
        string(name: 'UART_READY_TIMEOUT', defaultValue: '',
               description: 'Runner READY timeout in seconds; blank uses the board default (240, Megrez 300).')
        string(name: 'UART_RESULT_TIMEOUT', defaultValue: '600', description: 'ELF completion timeout.')
        booleanParam(name: 'RUN_AI_TRIAGE', defaultValue: true,
            description: 'Add an AI analysis (failure reason, root cause, next step) when the ELF fails; advisory only.')
        choice(name: 'AI_TRIAGE_PROVIDER', choices: ['codex', 'openai'],
            description: 'codex: the Codex CLI on the agent (ChatGPT login). openai: the OpenAI API with AI_TRIAGE_CREDENTIAL_ID.')
        string(name: 'AI_TRIAGE_MODEL', defaultValue: '', description: 'Model name; blank uses the provider default.')
        string(name: 'AI_TRIAGE_CREDENTIAL_ID', defaultValue: 'openai-api-key',
            description: 'Jenkins Secret Text credential with an OpenAI API key (openai provider only).')
    }

    environment {
        RUNNER_REMOTE_URL = 'https://github.com/farazahmad-10xe/ACT-Runner-for-Vision-Five-2-RISC-V-Board-.git'
        LOCAL_TUYA_DEVICES_SOURCE = '/data/ci/devices.json'
        // Agent-to-portal traffic uses the certificate name; /etc/hosts maps apollo on the agent.
        PORTAL_URL = 'https://apollo/portal/'
        INTERNAL_CA_FILE = '/data/ci/agent/jenkins-internal-ca.crt'
        PATH = '/data/ci/bin:/usr/local/bin:/usr/bin:/bin'
    }

    stages {
        stage('Clean Checkout') {
            steps {
                deleteDir()
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    branch="${RUNNER_BRANCH:-vf2-uart-stream-jenkins}"
                    revision_override="${RUNNER_REVISION_OVERRIDE:-}"
                    git check-ref-format --branch "$branch" >/dev/null
                    git init .
                    git remote add origin "$RUNNER_REMOTE_URL"
                    ref="refs/remotes/origin/$branch"
                    fetched=false
                    for attempt in 1 2 3 4; do
                      if timeout 180 git -c http.lowSpeedLimit=1 -c http.lowSpeedTime=30 \
                        fetch --force origin "+refs/heads/$branch:$ref"; then
                        fetched=true
                        break
                      fi
                      [[ "$attempt" -eq 4 ]] || sleep "$((attempt * 15))"
                    done
                    [[ "$fetched" == true ]] || { echo "Runner fetch failed" >&2; exit 1; }
                    selected="$(git rev-parse --verify "$ref^{commit}")"
                    if [[ -n "$revision_override" ]]; then
                      selected="$(git rev-parse --verify "$revision_override^{commit}")"
                    fi
                    git checkout --detach "$selected"
                    install -m 0600 "$LOCAL_TUYA_DEVICES_SOURCE" devices.json
                    test -x ci/jenkins/single_elf_uart.sh
                    python3 ci/check_minimal_uart_repo.py
                '''
            }
        }

        stage('Verify Uploaded ELF') {
            steps { sh 'ci/jenkins/single_elf_uart.sh prepare' }
        }

        stage('UART Execute') {
            steps {
                script {
                    def execute = {
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            sh 'ci/jenkins/single_elf_uart.sh run'
                        }
                    }
                    if (params.TARGET_BOARD == 'milkv-megrez') {
                        // SCW1050 powers the Megrez and is also the BPI-F3 and VF2 outlet:
                        // hold all three board locks, like the Megrez sanity and weekly jobs.
                        lock(resource: 'vf2-hardware') {
                            lock(resource: 'bpif3-hardware') {
                                lock(resource: 'megrez-hardware') { execute() }
                            }
                        }
                    } else {
                        def hardwareLock = params.TARGET_BOARD == 'bananapi-f3' ?
                            'bpif3-hardware' : 'vf2-hardware'
                        lock(resource: hardwareLock) { execute() }
                    }
                }
            }
        }
    }

    post {
        always {
            junit testResults: "logs/runs/jenkins_single_elf_${env.BUILD_NUMBER}/junit.xml",
                  allowEmptyResults: true,
                  keepLongStdio: true
            script {
                // Failure triage (AI when available): advisory only, never changes the result.
                if (fileExists('ci/jenkins/single_elf_uart.sh')) {
                    def triageRc = 0
                    if (params.RUN_AI_TRIAGE && params.AI_TRIAGE_PROVIDER == 'openai') {
                        try {
                            withCredentials([string(credentialsId: params.AI_TRIAGE_CREDENTIAL_ID,
                                                    variable: 'OPENAI_API_KEY')]) {
                                triageRc = sh(script: 'ci/jenkins/single_elf_uart.sh triage', returnStatus: true)
                            }
                        } catch (Exception exc) {
                            echo "OpenAI credential unavailable (${exc.getMessage()}); deterministic triage only."
                            withEnv(['RUN_AI_TRIAGE=false']) {
                                triageRc = sh(script: 'ci/jenkins/single_elf_uart.sh triage', returnStatus: true)
                            }
                        }
                    } else {
                        triageRc = sh(script: 'ci/jenkins/single_elf_uart.sh triage', returnStatus: true)
                    }
                    if (triageRc != 0) {
                        echo "Triage failed with rc=${triageRc}; the UART result is unchanged."
                    }
                }
                if (fileExists('ci/jenkins/publish_single_elf_result.py')) {
                    withCredentials([string(credentialsId: 'riscv-portal-ingest-token',
                                            variable: 'PORTAL_INGEST_TOKEN')]) {
                        sh '''#!/usr/bin/env bash
                            set -euo pipefail
                            state_root="logs/jenkins/single_elf/${BUILD_NUMBER}"
                            run_root="logs/runs/jenkins_single_elf_${BUILD_NUMBER}"
                            mkdir -p "$state_root"
                            python3 ci/jenkins/publish_single_elf_result.py \
                              --run-root "$run_root" \
                              --board "$TARGET_BOARD" \
                              --submission-id "$SUBMISSION_ID" \
                              --elf-name "$ELF_NAME" \
                              --elf-sha256 "$ELF_SHA256" \
                              --job-name "$JOB_NAME" \
                              --build-number "$BUILD_NUMBER" \
                              --build-url "$BUILD_URL" \
                              --portal-url "$PORTAL_URL" \
                              --ca-file "$INTERNAL_CA_FILE" \
                              --git-revision "$(git rev-parse HEAD 2>/dev/null || true)" \
                              --output "$state_root/portal_payload.json" \
                              | tee "$state_root/portal_response.json"
                            python3 -c 'import json,pathlib,sys,urllib.parse; r=json.loads(pathlib.Path(sys.argv[1]).read_text()); u=r.get("url"); u or sys.exit("missing portal URL"); pathlib.Path(sys.argv[2]).write_text(urllib.parse.urljoin("https://110.93.227.10:9123",u)+"\\n")' \
                              "$state_root/portal_response.json" "$state_root/portal_url.txt"
                            if [[ -f "$run_root/triage/summary.json" ]]; then
                              if ! python3 ci/triage/publish_triage.py \
                                --run-root "$run_root" \
                                --job-name "$JOB_NAME-$TARGET_BOARD" \
                                --build-number "$BUILD_NUMBER" \
                                --portal-url "$PORTAL_URL" \
                                --ca-file "$INTERNAL_CA_FILE" \
                                --output "$state_root/portal_triage_response.json"; then
                                echo 'Advisory triage could not be published; the UART result is unchanged.' >&2
                              fi
                            fi
                        '''
                    }
                    def portalFile = "logs/jenkins/single_elf/${env.BUILD_NUMBER}/portal_url.txt"
                    if (fileExists(portalFile)) {
                        def portalUrl = readFile(portalFile).trim()
                        currentBuild.description = "<a href=\"${portalUrl}\">Portal UART result</a>"
                        echo "Portal result: ${portalUrl}"
                    }
                }
            }
            archiveArtifacts artifacts: "logs/jenkins/single_elf/${env.BUILD_NUMBER}/state.env, logs/jenkins/single_elf/${env.BUILD_NUMBER}/portal_*.json, logs/jenkins/single_elf/${env.BUILD_NUMBER}/portal_url.txt, logs/jenkins/single_elf/${env.BUILD_NUMBER}/portal_triage_response.json, logs/runs/jenkins_single_elf_${env.BUILD_NUMBER}/**",
                             allowEmptyArchive: true,
                             fingerprint: true
        }
    }
}
