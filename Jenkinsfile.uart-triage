pipeline {
    agent {
        node {
            label 'riscv-hw-agent'
            customWorkspace '/data/ci/agent/workspace/riscv-uart-triage'
        }
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '30'))
        timeout(time: 2, unit: 'HOURS')
        timestamps()
        skipDefaultCheckout(true)
    }

    parameters {
        string(name: 'RUNNER_BRANCH', defaultValue: 'vf2-uart-stream-jenkins',
            description: 'Runner branch containing the triage agent.')
        string(name: 'RUNNER_REVISION_OVERRIDE', defaultValue: '',
            description: 'Optional exact runner commit.')
        choice(name: 'SOURCE_JOB', choices: ['vf2-uart-weekly', 'bpif3-uart-weekly', 'megrez-uart-weekly',
                                          'vf2-uart-sanity', 'bpif3-uart-sanity', 'megrez-uart-sanity'],
            description: 'Weekly or sanity job whose retained artifacts will be analyzed.')
        string(name: 'SOURCE_BUILD_NUMBER', defaultValue: '',
            description: 'Build number of SOURCE_JOB to triage. Only builds kept in the agent artifact store can be triaged; if the build is not there, the console lists the ones that are.')
        booleanParam(name: 'RUN_AI_TRIAGE', defaultValue: true,
            description: 'Add an AI analysis (failure reason, root cause, next step) for every failed case; advisory, never changes test verdicts. Falls back to deterministic triage if the AI cannot run.')
        choice(name: 'AI_TRIAGE_PROVIDER', choices: ['codex', 'openai'],
            description: 'codex: the Codex CLI on the agent, logged in with a ChatGPT account. openai: the OpenAI API with AI_TRIAGE_CREDENTIAL_ID.')
        string(name: 'AI_TRIAGE_MODEL', defaultValue: '',
            description: 'Model name; blank uses the provider default.')
        string(name: 'AI_TRIAGE_CREDENTIAL_ID', defaultValue: 'openai-api-key',
            description: 'Jenkins Secret Text credential with an OpenAI API key (openai provider only).')
        string(name: 'AI_TRIAGE_MAX_FAILURES', defaultValue: '0',
            description: 'Maximum failed cases sent for AI analysis; 0 means every failure.')
        booleanParam(name: 'PUBLISH_TO_PORTAL', defaultValue: true,
            description: 'Fill the triage columns of the existing run in the portal workbook.')
        string(name: 'PORTAL_CREDENTIAL_ID', defaultValue: 'riscv-portal-ingest-token',
            description: 'Jenkins Secret Text credential containing the portal ingest token.')
    }

    environment {
        RUNNER_REMOTE_URL = 'https://github.com/farazahmad-10xe/ACT-Runner-for-Vision-Five-2-RISC-V-Board-.git'
        ARTIFACT_STORE = '/data/ci/agent/results-artifacts'
        PATH = '/data/ci/bin:/usr/local/bin:/usr/bin:/bin'
    }

    stages {
        stage('Clean Checkout') {
            steps {
                deleteDir()
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    branch="${RUNNER_BRANCH:-vf2-uart-stream-jenkins}"
                    override="${RUNNER_REVISION_OVERRIDE:-}"
                    git check-ref-format --branch "$branch" >/dev/null
                    git init .
                    git remote add origin "$RUNNER_REMOTE_URL"
                    ref="refs/remotes/origin/$branch"
                    git fetch --force --prune origin "+refs/heads/$branch:$ref"
                    fetched="$(git rev-parse --verify "${ref}^{commit}")"
                    selected="${override:-$fetched}"
                    selected="$(git rev-parse --verify "$selected^{commit}")"
                    git checkout --detach "$selected"
                    test -f ci/triage/run_ci_triage.py
                '''
            }
        }

        stage('Load Retained Run') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    echo "Requested: SOURCE_JOB=$SOURCE_JOB SOURCE_BUILD_NUMBER=${SOURCE_BUILD_NUMBER:-<empty>}"
                    available() {
                      echo "Builds that can be triaged (job: build numbers with failures to analyze):" >&2
                      local found=false job_dir job builds
                      for job_dir in "$ARTIFACT_STORE"/*/; do
                        [[ -d "$job_dir" ]] || continue
                        job="$(basename "$job_dir")"
                        builds="$(python3 - "$job_dir" <<'PY'
import json, sys
from pathlib import Path
keep = []
for build in Path(sys.argv[1]).iterdir():
    try:
        cases = json.loads((build / "cases.json").read_text())
    except (OSError, ValueError):
        continue
    if build.name.isdigit() and any(str(c.get("status", "")).upper() != "PASS" for c in cases):
        keep.append(int(build.name))
print(" ".join(str(b) for b in sorted(keep)))
PY
)"
                        [[ -z "$builds" ]] || { echo "  $job: $builds" >&2; found=true; }
                      done
                      [[ "$found" == true ]] || echo "  (none)" >&2
                    }
                    [[ "$SOURCE_BUILD_NUMBER" =~ ^[1-9][0-9]*$ ]] || {
                      echo "SOURCE_BUILD_NUMBER must be a build number." >&2
                      available
                      exit 2
                    }
                    case "$SOURCE_JOB" in
                      vf2-uart-weekly|bpif3-uart-weekly|megrez-uart-weekly) ;;
                      vf2-uart-sanity|bpif3-uart-sanity|megrez-uart-sanity) ;;
                      *) echo "Unsupported SOURCE_JOB: $SOURCE_JOB" >&2; exit 2 ;;
                    esac
                    source_root="$ARTIFACT_STORE/$SOURCE_JOB/$SOURCE_BUILD_NUMBER"
                    test -f "$source_root/cases.json" || {
                      echo "$SOURCE_JOB #$SOURCE_BUILD_NUMBER is not in the artifact store ($source_root)." >&2
                      available
                      exit 2
                    }
                    mkdir -p input state
                    cp -a "$source_root/." input/
                '''
            }
        }

        stage('Triage Failures') {
            steps {
                script {
                    def command = '''#!/usr/bin/env bash
                        set -euo pipefail
                        case "$SOURCE_JOB" in
                          bpif3-*) board=bpif3_k1 ;;
                          megrez-*) board=milkv_megrez_eic7700x ;;
                          *) board=vf2_jh7110 ;;
                        esac
                        ci/triage/jenkins_triage.sh input state "$board"
                    '''
                    if (params.RUN_AI_TRIAGE && params.AI_TRIAGE_PROVIDER == 'openai') {
                        withCredentials([string(credentialsId: params.AI_TRIAGE_CREDENTIAL_ID,
                                                variable: 'OPENAI_API_KEY')]) {
                            sh command
                        }
                    } else {
                        sh command
                    }
                }
            }
        }

        stage('Update Existing Portal Run') {
            when { expression { return params.PUBLISH_TO_PORTAL } }
            steps {
                withCredentials([string(credentialsId: params.PORTAL_CREDENTIAL_ID,
                                        variable: 'PORTAL_INGEST_TOKEN')]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        python3 ci/triage/publish_triage.py \
                          --run-root input \
                          --job-name "$SOURCE_JOB" \
                          --build-number "$SOURCE_BUILD_NUMBER" \
                          --portal-url 'https://apollo/portal/' \
                          --ca-file /data/ci/agent/jenkins-internal-ca.crt \
                          --output portal_response.json
                        python3 -c 'import json, pathlib; r=json.loads(pathlib.Path("portal_response.json").read_text()); pathlib.Path("portal_url.txt").write_text("https://110.93.227.10:9123" + r["url"] + chr(10))'
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'input/triage/**',
                             allowEmptyArchive: true,
                             fingerprint: true
            script {
                def sourceUrl = "https://110.93.227.10:9123/job/${params.SOURCE_JOB}/${params.SOURCE_BUILD_NUMBER}/"
                def reportUrl = "${env.BUILD_URL}artifact/input/triage/summary.md"
                def portalUrl = ""
                if (fileExists('portal_url.txt')) {
                    portalUrl = readFile('portal_url.txt').trim()
                }
                currentBuild.description = "Source: <a href=\"${sourceUrl}\">${params.SOURCE_JOB} #${params.SOURCE_BUILD_NUMBER}</a> | <a href=\"${reportUrl}\">Triage report</a>" + (portalUrl ? " | <a href=\"${portalUrl}\">Portal run</a>" : "")
            }
        }
    }
}
