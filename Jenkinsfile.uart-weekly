pipeline {
    agent {
        node {
            label 'riscv-hw-agent'
            customWorkspace '/data/ci/agent/workspace/vf2-uart-weekly'
        }
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '8', artifactNumToKeepStr: '8'))
        timeout(time: 30, unit: 'HOURS')
        timestamps()
        skipDefaultCheckout(true)
    }

    triggers {
        cron('H H * * 0')
    }

    parameters {
        string(name: 'RUNNER_BRANCH', defaultValue: 'vf2-uart-stream-jenkins',
            description: 'Runner branch resolved once at checkout.')
        string(name: 'RUNNER_REVISION_OVERRIDE', defaultValue: '',
            description: 'Optional exact runner commit.')
        string(name: 'ACT_BRANCH', defaultValue: 'sifive_u74',
            description: 'ACT branch resolved once at preflight.')
        string(name: 'ACT_REVISION_OVERRIDE', defaultValue: '',
            description: 'Optional exact ACT commit.')
        choice(name: 'TEST_SCOPE', choices: ['all', 'priv'],
            description: 'all: privileged + non-privileged + vector tests; priv: privileged tests only.')
        booleanParam(name: 'RUN_SPIKE', defaultValue: true,
            description: 'Run every Sail-runnable ELF on Spike before VF2.')
        booleanParam(name: 'RUN_HARDWARE', defaultValue: true,
            description: 'Stream every Sail-runnable ELF to the persistent VF2 runner.')
        string(name: 'SERIAL_DEV', defaultValue: '/dev/ttyCI-vf2',
            description: 'VF2 USB-UART device path.')
        string(name: 'INSTALLED_RUNNER_BUILD', defaultValue: '',
            description: 'Optional override; blank uses ci/runner_inventory.json.')
        string(name: 'UART_READY_TIMEOUT', defaultValue: '180',
            description: 'Seconds allowed for each power-cycled board to advertise READY.')
        string(name: 'UART_RESULT_TIMEOUT', defaultValue: '600',
            description: 'Seconds allowed for each ELF to finish after transfer.')
        booleanParam(name: 'PUBLISH_RESULTS', defaultValue: true,
            description: 'Publish the normalized weekly run to the Apollo results portal.')
        string(name: 'PORTAL_CREDENTIAL_ID', defaultValue: 'riscv-portal-ingest-token',
            description: 'Apollo Jenkins secret-text credential containing the portal ingest token.')
        booleanParam(name: 'RUN_TRIAGE', defaultValue: true,
            description: 'Generate deterministic evidence reports for every non-PASS case.')
        booleanParam(name: 'RUN_AI_TRIAGE', defaultValue: false,
            description: 'Optionally add advisory AI analysis for failed cases; never changes test verdicts.')
        string(name: 'AI_TRIAGE_MODEL', defaultValue: 'gpt-5',
            description: 'Organization-approved OpenAI Responses API model for optional analysis.')
        string(name: 'AI_TRIAGE_CREDENTIAL_ID', defaultValue: 'openai-api-key',
            description: 'Jenkins Secret Text credential containing the OpenAI API key.')
        string(name: 'AI_TRIAGE_MAX_FAILURES', defaultValue: '0',
            description: 'Maximum failed cases sent for AI analysis; 0 means every failure.')
    }

    environment {
        RUNNER_REMOTE_URL = 'https://github.com/farazahmad-10xe/ACT-Runner-for-Vision-Five-2-RISC-V-Board-.git'
        ACT_REMOTE_URL = 'https://github.com/Arshia2564/riscv-arch-test.git'
        LOCAL_TOOLS_SOURCE = '/data/ci/tools'
        LOCAL_TUYA_DEVICES_SOURCE = '/data/ci/devices.json'
        REGENERATE_TESTS = 'true'
        SAIL_BIN = '/data/ci/toolchains/riscv-sail-0.14.1/bin/sail_riscv_sim'
        SAIL_EXPECTED_VERSION = '0.14.1'
        INSTALLED_RUNNER_BUILD = "${params.INSTALLED_RUNNER_BUILD ?: ''}"
        PATH = '/data/ci/bin:/data/ci/toolchains/riscv64/bin:/data/ci/toolchains/riscv-sail-0.14.1/bin:/usr/local/bin:/usr/bin:/bin'
    }

    stages {
        stage('Clean Checkout') {
            steps {
                deleteDir()
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    runner_branch="${RUNNER_BRANCH:-vf2-uart-stream-jenkins}"
                    runner_revision_override="${RUNNER_REVISION_OVERRIDE:-}"
                    git check-ref-format --branch "$runner_branch" >/dev/null
                    git init .
                    git remote add origin "$RUNNER_REMOTE_URL"
                    runner_ref="refs/remotes/origin/$runner_branch"
                    fetch_ok=false
                    for attempt in 1 2 3 4; do
                      echo "Runner fetch attempt ${attempt}/4"
                      if timeout 180 git -c http.lowSpeedLimit=1 \
                        -c http.lowSpeedTime=30 fetch --force --prune origin \
                        "+refs/heads/$runner_branch:$runner_ref"; then
                        fetch_ok=true
                        break
                      fi
                      if [[ "$attempt" -lt 4 ]]; then
                        sleep "$((attempt * 15))"
                      fi
                    done
                    [[ "$fetch_ok" == true ]] || {
                      echo "Unable to fetch runner branch after 4 attempts: $runner_branch" >&2
                      exit 1
                    }
                    fetched="$(git rev-parse --verify "${runner_ref}^{commit}")"
                    selected="${runner_revision_override:-$fetched}"
                    selected="$(git rev-parse --verify "$selected^{commit}")"
                    git checkout --detach "$selected"
                    submodule_ok=false
                    for attempt in 1 2 3 4; do
                      echo "ACT submodule update attempt ${attempt}/4"
                      if timeout 300 git -c http.lowSpeedLimit=1 \
                        -c http.lowSpeedTime=30 submodule update --init external/riscv-arch-test; then
                        submodule_ok=true
                        break
                      fi
                      if [[ "$attempt" -lt 4 ]]; then
                        sleep "$((attempt * 15))"
                      fi
                    done
                    [[ "$submodule_ok" == true ]] || {
                      echo "Unable to initialize ACT submodule after 4 attempts" >&2
                      exit 1
                    }
                    mkdir -p tools
                    cp -a "$LOCAL_TOOLS_SOURCE/." tools/
                    install -m 0600 "$LOCAL_TUYA_DEVICES_SOURCE" devices.json
                    {
                      echo "Runner branch: $runner_branch"
                      echo "Runner SHA:    $selected"
                      echo "Checkout:      detached"
                    } | tee .jenkins_runner_resolution.txt
                    test -x ci/jenkins/uart_weekly_vf2.sh
                '''
            }
        }

        stage('ACT Preflight') {
            steps { sh 'ci/jenkins/uart_weekly_vf2.sh preflight' }
        }

        stage('Generate Selected ACT Scope + Sail') {
            steps { sh 'ci/jenkins/uart_weekly_vf2.sh prepare' }
        }

        stage('Spike Reference') {
            when { expression { return params.RUN_SPIKE } }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh 'ci/jenkins/uart_weekly_vf2.sh spike'
                }
            }
        }

        stage('Build Candidate UART Runner') {
            steps { sh 'ci/jenkins/uart_weekly_vf2.sh verify-runner-image' }
        }

        stage('VF2 UART Execute') {
            when { expression { return params.RUN_HARDWARE } }
            steps {
                lock(resource: 'vf2-hardware') {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                        sh '''#!/usr/bin/env bash
                            SERIAL_DEV="$SERIAL_DEV" \
                            UART_READY_TIMEOUT="$UART_READY_TIMEOUT" \
                            UART_RESULT_TIMEOUT="$UART_RESULT_TIMEOUT" \
                              ci/jenkins/uart_weekly_vf2.sh run
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            sh 'test ! -x ci/jenkins/uart_weekly_vf2.sh || ci/jenkins/uart_weekly_vf2.sh finalize || true'
            junit testResults: "logs/runs/jenkins_uart_weekly_${env.BUILD_NUMBER}/junit.xml",
                  allowEmptyResults: true,
                  keepLongStdio: true
            script {
                if (params.RUN_TRIAGE) {
                    def triageCommand = '''#!/usr/bin/env bash
                        set -euo pipefail
                        run_root="logs/runs/jenkins_uart_weekly_${BUILD_NUMBER}"
                        state_root="logs/jenkins/uart_weekly/jenkins_uart_weekly_${BUILD_NUMBER}"
                        test -f "$run_root/cases.json" || {
                          echo "Triage skipped: $run_root/cases.json is unavailable"
                          exit 0
                        }
                        args=(
                          --run-root "$run_root"
                          --state-root "$state_root"
                          --board vf2_jh7110
                          --model "$AI_TRIAGE_MODEL"
                          --max-ai-failures "$AI_TRIAGE_MAX_FAILURES"
                        )
                        [[ "$RUN_AI_TRIAGE" != true ]] || args+=(--ai)
                        python3 ci/triage/run_ci_triage.py "${args[@]}"
                    '''
                    def triageRc = 0
                    if (params.RUN_AI_TRIAGE) {
                        try {
                            withCredentials([string(credentialsId: params.AI_TRIAGE_CREDENTIAL_ID,
                                                    variable: 'OPENAI_API_KEY')]) {
                                triageRc = sh(script: triageCommand, returnStatus: true)
                            }
                        } catch (Exception exc) {
                            triageRc = 1
                            echo "Optional AI triage could not start: ${exc.getMessage()}"
                        }
                    } else {
                        triageRc = sh(script: triageCommand, returnStatus: true)
                    }
                    if (triageRc != 0) {
                        echo "ACT CI triage failed with rc=${triageRc}; certification result is unchanged."
                    }
                }
                if (params.PUBLISH_RESULTS) {
                    withCredentials([string(credentialsId: params.PORTAL_CREDENTIAL_ID,
                                            variable: 'PORTAL_INGEST_TOKEN')]) {
                        withEnv(["PORTAL_BUILD_STATUS=${currentBuild.currentResult}"]) {
                            sh '''#!/usr/bin/env bash
                                set -euo pipefail
                                state_root="logs/jenkins/uart_weekly/jenkins_uart_weekly_${BUILD_NUMBER}"
                                run_root="logs/runs/jenkins_uart_weekly_${BUILD_NUMBER}"
                                python3 /data/ci/agent/tools/publish_jenkins_results.py \
                                  --state-root "$state_root" \
                                  --run-root "$run_root" \
                                  --board-slug visionfive2 \
                                  --board-name 'StarFive VisionFive 2' \
                                  --core-profile 'SiFive U74-MC' \
                                  --job-name "$JOB_NAME" \
                                  --build-number "$BUILD_NUMBER" \
                                  --build-url "$BUILD_URL" \
                                  --status "$PORTAL_BUILD_STATUS" \
                                  --portal-url 'https://apollo/portal/' \
                                  --ca-file /data/ci/agent/jenkins-internal-ca.crt \
                                  --suite-inventory-xlsx /data/ci/agent/reference/vf2-suite-inventory.xlsx \
                                  --artifact-store /data/ci/agent/results-artifacts \
                                  --output "$state_root/portal_payload.json" \
                                  | tee "$state_root/portal_response.json"
                                python3 -c 'import json, pathlib, sys, urllib.parse; response=json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8")); relative_url=response.get("url"); relative_url or sys.exit("Portal response did not contain a run URL"); pathlib.Path(sys.argv[2]).write_text(urllib.parse.urljoin("https://192.168.100.61", relative_url) + chr(10), encoding="utf-8")' \
                                  "$state_root/portal_response.json" \
                                  "$state_root/portal_url.txt"
                                if [[ -f "$run_root/triage/summary.json" ]]; then
                                  if ! python3 ci/triage/publish_triage.py \
                                    --run-root "$run_root" \
                                    --job-name "$JOB_NAME" \
                                    --build-number "$BUILD_NUMBER" \
                                    --portal-url 'https://apollo/portal/' \
                                    --ca-file /data/ci/agent/jenkins-internal-ca.crt \
                                    --output "$state_root/portal_triage_response.json"; then
                                    echo 'Advisory triage could not be published; certification result is unchanged.' >&2
                                  fi
                                fi
                            '''
                        }
                    }
                    def portalUrlFile = "logs/jenkins/uart_weekly/jenkins_uart_weekly_${env.BUILD_NUMBER}/portal_url.txt"
                    if (fileExists(portalUrlFile)) {
                        def portalUrl = readFile(portalUrlFile).trim()
                        currentBuild.description = "${params.TEST_SCOPE}: <a href=\"${portalUrl}\">Portal results</a>"
                        echo "Portal results: ${portalUrl}"
                    }
                }
            }
            archiveArtifacts artifacts: "logs/jenkins/uart_weekly/jenkins_uart_weekly_${env.BUILD_NUMBER}/**, logs/runs/jenkins_uart_weekly_${env.BUILD_NUMBER}/**, logs/reference-model-runs/jenkins_uart_weekly_${env.BUILD_NUMBER}/**, cert_harness/build/vf2_jh7110/UART_M_MODE/manifest.json",
                             allowEmptyArchive: true,
                             fingerprint: true
        }
    }
}
