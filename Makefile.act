CC ?= riscv64-unknown-elf-gcc
OBJCOPY ?= riscv64-unknown-elf-objcopy
OBJDUMP ?= riscv64-unknown-elf-objdump

CFLAGS = -march=rv64imafdc_zicsr_zifencei -mabi=lp64d -mcmodel=medany -Os \
         -ffreestanding -nostdlib -fno-builtin -fno-stack-protector -fno-pic \
         -fno-plt -Wall -Wextra
LDFLAGS = -T $(LINKER_SCRIPT) -nostdlib -Wl,-Map,firmware.map

LINKER_SCRIPT ?= link.ld
BOARD_CFLAGS ?=
BOARD_LDFLAGS ?=
RUNNER_BUILD_ID ?= unknown
RUNNER_TEST_TIMEOUT_TICKS ?= 50000000ULL
RUNNER_RESET_DELAY_TICKS ?= 20000000ULL
RUNNER_UART_RX_TIMEOUT_TICKS ?= 200000000ULL

# This branch intentionally supports one execution environment only:
# ACT-compatible ELF payloads streamed over UART and entered in M-mode.
CFLAGS += -DRUNNER_EXEC_MODE=EXEC_MODE_M
CFLAGS += -DRUNNER_UART_STREAM=1
CFLAGS += -DRUNNER_ENABLE_LOWER_MODES=0
CFLAGS += -DRUNNER_ENABLE_TSBI=0
CFLAGS += -DRUNNER_ENABLE_PRIVATE_SBI=0
CFLAGS += -DRUNNER_TOUCH_MENVCFG=0
CFLAGS += -DRUNNER_ASSUME_RVA23_PRIV_FEATURES=0
CFLAGS += -DRUNNER_USE_SV39=0
CFLAGS += -DRUNNER_DELEG_POLICY=DELEGATION_POLICY_NONE
CFLAGS += -DRUNNER_BUILD_ID=\"$(RUNNER_BUILD_ID)\"
CFLAGS += -DRUNNER_TEST_TIMEOUT_TICKS=$(RUNNER_TEST_TIMEOUT_TICKS)
CFLAGS += -DRUNNER_RESET_DELAY_TICKS=$(RUNNER_RESET_DELAY_TICKS)
CFLAGS += -DRUNNER_UART_RX_TIMEOUT_TICKS=$(RUNNER_UART_RX_TIMEOUT_TICKS)
CFLAGS += $(BOARD_CFLAGS)
LDFLAGS += $(BOARD_LDFLAGS)

RUNNER_SRCS = start.S main_act.c act_core.c act_runtime.c runner_lower_env.c \
              runner_sbi.c runner_umode.c runner_machine_trap.c runner_monitor.c \
              runner_k1_hart_wakeup.c runner_uart_stream.c

.PHONY: all clean
all: firmware.elf firmware.bin firmware.dis

firmware.elf: $(RUNNER_SRCS) runner_shared.h $(LINKER_SCRIPT)
	$(CC) $(CFLAGS) $(RUNNER_SRCS) -o $@ $(LDFLAGS)

firmware.bin: firmware.elf
	$(OBJCOPY) -O binary $< $@

firmware.dis: firmware.elf
	$(OBJDUMP) -d $< > $@

clean:
	rm -f firmware.elf firmware.bin firmware.dis firmware.map
