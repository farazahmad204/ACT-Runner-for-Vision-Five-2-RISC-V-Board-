BOARD_NAME=bpif3_k1
BOARD_DESCRIPTION="Banana Pi BPI-F3 / SpacemiT K1"
BOARD_ADAPTER=bpif3_k1
BOARD_PAYLOAD_TRANSPORT=uart_stream
BOARD_PLATFORM_ID=2

BOARD_FIT_SOURCE=bpif3_opensbi.its
BOARD_BOOT_IMAGE=bpif3_opensbi.itb
BOARD_BOOT_IMAGE_PAD_BYTES=
BOARD_LINKER_SCRIPT=link.ld

BOARD_FW_LOAD_ADDR=0x04000000
BOARD_FW_STACK_BYTES=0x4000
BOARD_RAM_BASE=0x04000000
BOARD_RAM_LIMIT=0x80000000

BOARD_UART_BASE=0xD4017000
BOARD_UART_SIZE=0x1000
BOARD_PLIC_BASE=0xE0000000
BOARD_UART_PLIC_SOURCE=42
BOARD_RUNNER_M_PLIC_CONTEXT=0
BOARD_RUNNER_S_PLIC_CONTEXT=1
BOARD_CLINT_MSIP_BASE=0xE4000000
BOARD_CLINT_MTIMECMP_BASE=0xE4004000
BOARD_CLINT_MTIME_ADDR=0xE400BFF8

BOARD_RUNNER_HART_ID=0
BOARD_MONITOR_HART_ID=1

BOARD_FIXED_TOHOST_ADDR=0x04100000
BOARD_UART_ELF_BUFFER_ADDR=0x0C200000
BOARD_UART_ELF_MAX_BYTES=134217728
BOARD_TEST_STACK_BYTES=262144
BOARD_TRAP_STACK_BYTES=1024

BOARD_WDT_ENABLE=0
BOARD_WDT_BASE=0
BOARD_WDT_LOAD=0
BOARD_WDT_CTRL=0
BOARD_WDT_LOCK=0
BOARD_WDT_UNLOCK_KEY=0

BOARD_K1_HART_WAKEUP_ENABLE=1

DEFAULT_SERIAL_DEV=/dev/ttyCI-bpif3

TOOLCHAIN_DIR=
TOOLCHAIN_TRIPLE=riscv64-unknown-elf
