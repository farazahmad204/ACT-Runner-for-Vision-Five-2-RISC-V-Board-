BOARD_NAME=milkv_megrez_eic7700x
BOARD_DESCRIPTION="Milk-V Megrez / ESWIN EIC7700X"
BOARD_ADAPTER=milkv_megrez_eic7700x
BOARD_PLATFORM_ID=3

BOARD_PACKAGE_MODE=adapter
BOARD_BOOT_IMAGE=bootloader_secboot_ddr5.bin
BOARD_LINKER_SCRIPT=cert_harness/boards/milkv_megrez_eic7700x/link.ld

BOARD_FW_LOAD_ADDR=0x80000000
BOARD_FW_STACK_BYTES=0x4000
BOARD_RAM_BASE=0x80000000
BOARD_RAM_LIMIT=0xC8000000
BOARD_PAYLOAD_BASE=0x90000000
BOARD_PAYLOAD_LIMIT=0xB0000000
BOARD_DDR_EXCLUDE_BASE=0xB0000000
BOARD_DDR_EXCLUDE_LIMIT=0xC0000000

BOARD_UART_BASE=0x50900000
BOARD_UART_SIZE=0x10000
BOARD_UART_REG_IO_WIDTH=2
BOARD_UART_8250_INIT_ENABLE=1
BOARD_UART_INPUT_CLOCK_HZ=200000000
BOARD_UART_BAUD=115200
BOARD_UART_RX_DIAG=0

BOARD_PLIC_BASE=0x0C000000
BOARD_UART_PLIC_SOURCE=0
BOARD_RUNNER_M_PLIC_CONTEXT=0
BOARD_RUNNER_S_PLIC_CONTEXT=0
BOARD_EXTERNAL_IRQ_CLEANUP_ENABLE=0

BOARD_CLINT_MSIP_BASE=0x02000000
BOARD_CLINT_MTIMECMP_BASE=0x02004000
BOARD_CLINT_MTIME_ADDR=0x0200BFF8
BOARD_RUNNER_HART_ID=1
BOARD_MONITOR_HART_ID=2

BOARD_FIXED_TOHOST_ADDR=0x90008000
BOARD_UART_ELF_BUFFER_ADDR=0xC0000000
BOARD_UART_ELF_MAX_BYTES=134217728
BOARD_TEST_STACK_BYTES=262144
BOARD_TRAP_STACK_BYTES=1024

BOARD_WDT_ENABLE=0
BOARD_WDT_BASE=0
BOARD_WDT_LOAD=0
BOARD_WDT_CTRL=0
BOARD_WDT_LOCK=0
BOARD_WDT_UNLOCK_KEY=0

# Onboard USB-C debug UART (CH340B on UART0). An external USB-TTL adapter
# cannot transmit to the board while USB-C is connected; see README.md.
DEFAULT_SERIAL_DEV=/dev/serial/by-id/usb-1a86_USB2.0-Serial-if00-port0

TOOLCHAIN_DIR=/home/lpt-10xe/riscv64/bin
TOOLCHAIN_TRIPLE=riscv64-unknown-elf
