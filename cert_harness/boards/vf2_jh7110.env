BOARD_NAME=vf2_jh7110
BOARD_DESCRIPTION="StarFive VisionFive2 / JH7110"
BOARD_ADAPTER=vf2_jh7110
BOARD_PAYLOAD_TRANSPORT=uart_stream
BOARD_PLATFORM_ID=1

BOARD_FIT_SOURCE=vf2_act4.its
BOARD_BOOT_IMAGE=uboot_part2_new.bin
BOARD_BOOT_IMAGE_PAD_BYTES=4194304
BOARD_LINKER_SCRIPT=link.ld

BOARD_FW_LOAD_ADDR=0x40000000
BOARD_FW_STACK_BYTES=0x4000
BOARD_RAM_BASE=0x40000000
BOARD_RAM_LIMIT=0x100000000

BOARD_UART_BASE=0x10000000
BOARD_UART_SIZE=0x1000
BOARD_UART_REG_IO_WIDTH=4
BOARD_PLIC_BASE=0x0c000000
BOARD_UART_PLIC_SOURCE=32
BOARD_RUNNER_M_PLIC_CONTEXT=1
BOARD_RUNNER_S_PLIC_CONTEXT=2
BOARD_CLINT_MSIP_BASE=0x02000000
BOARD_CLINT_MTIMECMP_BASE=0x02004000
BOARD_CLINT_MTIME_ADDR=0x0200bff8
BOARD_RUNNER_HART_ID=1
BOARD_MONITOR_HART_ID=2

BOARD_FIXED_TOHOST_ADDR=0x41008000
BOARD_UART_ELF_BUFFER_ADDR=0x88000000
BOARD_UART_ELF_MAX_BYTES=134217728
BOARD_TEST_STACK_BYTES=262144
BOARD_TRAP_STACK_BYTES=1024

BOARD_WDT_ENABLE=1
BOARD_WDT_BASE=0x13070000
BOARD_WDT_LOAD=0x000
BOARD_WDT_CTRL=0x008
BOARD_WDT_LOCK=0xc00
BOARD_WDT_UNLOCK_KEY=0x1acce551

DEFAULT_SERIAL_DEV=/dev/ttyCI-vf2

TOOLCHAIN_DIR=/data/ci/toolchains/riscv64/bin
TOOLCHAIN_TRIPLE=riscv64-unknown-elf
