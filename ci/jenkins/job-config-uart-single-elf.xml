<?xml version='1.1' encoding='UTF-8'?>
<flow-definition plugin="workflow-job">
  <actions/>
  <description>Portal-triggered execution of one pre-built RISC-V ELF on VF2 or BPI-F3 through the persistent UART runner.</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.StringParameterDefinition><name>SUBMISSION_ID</name><defaultValue></defaultValue><trim>true</trim></hudson.model.StringParameterDefinition>
        <hudson.model.ChoiceParameterDefinition><name>TARGET_BOARD</name><choices class="java.util.Arrays$ArrayList"><a class="string-array"><string>visionfive2</string><string>bananapi-f3</string><string>milkv-megrez</string></a></choices></hudson.model.ChoiceParameterDefinition>
        <hudson.model.StringParameterDefinition><name>ELF_DOWNLOAD_URL</name><defaultValue></defaultValue><trim>true</trim></hudson.model.StringParameterDefinition>
        <hudson.model.PasswordParameterDefinition><name>ELF_DOWNLOAD_TOKEN</name><defaultValue></defaultValue></hudson.model.PasswordParameterDefinition>
        <hudson.model.StringParameterDefinition><name>ELF_SHA256</name><defaultValue></defaultValue><trim>true</trim></hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition><name>ELF_NAME</name><defaultValue>uploaded.elf</defaultValue><trim>true</trim></hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition><name>RUNNER_BRANCH</name><defaultValue>vf2-uart-stream-jenkins</defaultValue><trim>true</trim></hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition><name>RUNNER_REVISION_OVERRIDE</name><defaultValue></defaultValue><trim>true</trim></hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition><name>SERIAL_DEV</name><defaultValue>/dev/ttyUSB0</defaultValue><trim>true</trim></hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition><name>UART_READY_TIMEOUT</name><defaultValue></defaultValue><trim>true</trim></hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition><name>UART_RESULT_TIMEOUT</name><defaultValue>600</defaultValue><trim>true</trim></hudson.model.StringParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
  </properties>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsFlowDefinition" plugin="workflow-cps">
    <script>__JENKINSFILE__</script>
    <sandbox>true</sandbox>
  </definition>
  <disabled>false</disabled>
</flow-definition>
