#!/usr/bin/env bash

# {{DESCRIPTION}} adapter skeleton, generated by gen_board_files.py.
# Boot pattern "custom": the vendor boot chain did not match a known pattern.
# Fill in board_package_image from the boot-flow evidence, then remove the
# NOT IMPLEMENTED guards. Keep vendor ROM/SPL/DDR stages untouched: the runner
# replaces only the final M-mode payload slot ({{SLOT}}).

board_package_image() {
  local repo_root="$1"
  local firmware_bin="$2"
  local out_dir="$3"

  : "$repo_root" "$firmware_bin" "$out_dir"
  # TODO: wrap $firmware_bin (load/entry {{LOAD_ADDR}}) into the slot format the
  # previous boot stage expects, write "$out_dir/boot_image.bin" and record
  # sha256 sums of every input tool and blob next to it.
  echo "ERROR: {{BOARD_ID}} packaging NOT IMPLEMENTED (custom boot pattern)" >&2
  return 1
}

board_flash_image() {
  echo "ERROR: {{BOARD_ID}} flashing is not automated; it needs a reviewed procedure and approval." >&2
  return 1
}

board_write_pack() {
  echo "ERROR: {{BOARD_ID}} UART transport does not use an SD-tail ELF pack." >&2
  return 1
}

board_capture_uart() {
  local serial_dev="$2"
  local log_path="$3"

  mkdir -p "$(dirname "$log_path")"
  picocom -b {{BAUD}} --flow n -q --logfile "$log_path" "$serial_dev"
}
